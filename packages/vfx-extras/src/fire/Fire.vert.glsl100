// FireMaterial vertex shader (GLSL 100). Derived from
// packages/engine/src/renderers/shaders/source/web_gl1/base.vert.glsl — keep in sync; the ONLY
// divergence is the world-space lean shear below.
attribute vec3 a_position;
attribute vec3 a_normal;
attribute vec2 a_uv;
attribute vec4 a_tangent; // (tx, ty, tz, w), w = ±1 bitangent handedness (MikkTSpace/glTF)

#ifdef USE_INSTANCING
attribute mat4 a_instanceMatrix;
#ifdef USE_INSTANCE_COLOR
attribute vec4 a_instanceData;
varying vec4 v_instanceColor;
#endif
#endif

uniform mat4 u_vp;
uniform mat4 u_model;
uniform vec2 u_texOffset;
uniform vec2 u_texRepeat;
uniform vec4 u_matParam4; // [lean.xyz (world-space tip displacement in m), unused]

varying vec3 v_worldPos;
varying vec3 v_normal;
varying vec2 v_uv;
varying mat3 v_tbn;
varying vec4 v_clipPos;

mat3 extractMat3(mat4 m) {
    return mat3(m[0].xyz, m[1].xyz, m[2].xyz);
}

void main() {
#ifdef USE_INSTANCING
    mat4 modelMat = u_model * a_instanceMatrix;
#ifdef USE_INSTANCE_COLOR
    v_instanceColor = a_instanceData;
#endif
#else
    mat4 modelMat = u_model;
#endif
    vec4 wp = modelMat * vec4(a_position, 1.0);
    v_uv = (a_uv * u_texRepeat) + u_texOffset;
    // World-space fire lean shear (2b): displace along the world-space lean axis by the SQUARED
    // height fraction, so the base stays anchored and the tip leans — uniformly across crossed
    // cards (the per-card fragment shear it replaces could not lean a card perpendicular to the wind).
    wp.xyz += u_matParam4.xyz * (v_uv.y * v_uv.y);
    v_worldPos = wp.xyz;
    mat3 m3 = extractMat3(modelMat);
    v_normal = normalize(m3 * a_normal);

    vec3 tangent = a_tangent.xyz;
    // Bitangent handedness w = ±1, folded into B in the vertex stage. Defaults to +1
    // when the tangent is zero/absent (degenerate or disabled attribute).
    float bitangentSign = length(tangent) < 0.0001 ? 1.0 : a_tangent.w;
    if (length(tangent) < 0.0001) {
        if (abs(v_normal.y) < 0.999) {
            tangent = cross(v_normal, vec3(0.0, 1.0, 0.0));
        } else {
            tangent = cross(v_normal, vec3(1.0, 0.0, 0.0));
        }
    }

    vec3 T = normalize(m3 * tangent);
    vec3 N = v_normal;
    T = normalize(T - dot(T, N) * N);
    vec3 B = cross(N, T) * bitangentSign;
    v_tbn = mat3(T, B, N);

    gl_Position = u_vp * wp;
    v_clipPos = gl_Position;
}
