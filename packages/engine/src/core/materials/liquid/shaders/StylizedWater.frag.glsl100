precision highp float;

varying vec3 v_worldPos;
varying vec3 v_normal;
varying vec2 v_uv;
varying vec4 v_clipPos;

[LIGHT_DEFS]
// WebGL1 has no shadow sampler: the chunk below is the constant-1.0 stub that extension surface hooks
// (OilSlickMaterial) call, so it must stay even though this shader itself never samples shadows.
[DIR_SHADOW]

uniform vec3 u_viewPos;
uniform vec4 u_color;
uniform vec4 u_specColor;
uniform vec2 u_texOffset;
uniform vec2 u_texRepeat;
// Dedicated material parameter bank (512-byte layout slots)
uniform vec4 u_matParam0; // [waterAbsorption.rgb, refractionStrength]
uniform vec4 u_matParam1; // [foamColor.rgb, foamDistance]
uniform vec4 u_matParam2; // [foamCutoff, foamNoiseScale, foamNoiseSpeed, unused]
uniform vec4 u_styleA;
uniform vec4 u_styleB;
uniform float u_time;
uniform sampler2D u_opaqueMap;
#ifdef USE_RAMP_LUT
uniform sampler2D u_rampMap;
#endif

[LIQUID_WORLEY_NOISE]
[LIQUID_CAUSTICS]
[LIQUID_GLINT]
[WATER_EXT_DECL]

// Anti-aliased threshold: replaces a binary step() with a smoothstep ramp so hard mask edges
// de-quantize instead of banding. WebGL1 has no fwidth/dFdx and OES_standard_derivatives is
// never enabled in this codebase, so the ramp width stays a fixed value-space constant here
// (the glsl300/wgsl backends scale it by fwidth) -- narrow enough to keep the toon shape, wide
// enough to avoid a 1px cutout pop-in.
float aaStepMask(float edge, float value, float softness) {
    return smoothstep(edge - softness, edge + softness, value);
}

void main() {
    vec3 shallowColor = pow(u_color.rgb, vec3(2.2));
    vec3 deepColor = pow(u_specColor.rgb, vec3(2.2));
    vec3 edgeColor = pow(vec3(u_texOffset.x, u_texOffset.y, u_texRepeat.x), vec3(2.2));
    float edgeSoftness = max(u_texRepeat.y, 0.001);

    // styleId map: 0 toon, 1 soft, 2 sparkle, 3 extension (Noir/Oil), 4 dredge, 5 bold
    float styleId = u_styleB.w;
    bool painterly = (styleId > 0.5 && styleId < 2.5) || styleId > 3.5;
    bool isSparkle = abs(styleId - 2.0) < 0.5;
    bool isExtension = abs(styleId - 3.0) < 0.5;
    bool isDredge = abs(styleId - 4.0) < 0.5;

    // Screen-space UV from the clip position (the mesh UV sampled the opaque map as a sub-rectangle)
    float refractionStrength = u_matParam0.a;
    vec3 waterAbsorption = u_matParam0.rgb;
    float foamDistance = max(u_matParam1.a, 0.001);

    vec2 screenUv = v_clipPos.xy / v_clipPos.w * 0.5 + 0.5;
    vec2 refractionUv = clamp(screenUv + v_normal.xz * refractionStrength, vec2(0.001), vec2(0.999));
    vec3 refractedColor = texture2D(u_opaqueMap, refractionUv).rgb;
    refractedColor = pow(refractedColor, vec3(2.2));

    vec3 viewDir = normalize(u_viewPos - v_worldPos);
    float fresnel = pow(1.0 - clamp(dot(v_normal, viewDir), 0.0, 1.0), 4.0);

    // Procedural Caustics
    float causticsSpeed = u_matParam2.b * 0.75;
    vec2 causticsUv1 = v_worldPos.xz * (u_matParam2.g * 0.85) + vec2(u_time * causticsSpeed, u_time * causticsSpeed * 0.5);
    vec2 causticsUv2 = v_worldPos.xz * (u_matParam2.g * 1.1) - vec2(u_time * causticsSpeed * 0.6, u_time * causticsSpeed * 0.8);
    float causticsFade = 1.0 - smoothstep(0.0, 1.0, fresnel);
    vec3 finalCaustics = vec3(0.0);
    vec3 illuminatedUnderwater = refractedColor;

    if (u_styleB.w > 0.5) {
        vec2 warpedCaustics = waterDomainWarp(v_worldPos.xz * (u_matParam2.g * 0.9), u_time * causticsSpeed);
        float lineSignal = waterCausticLine(warpedCaustics, 0.18);
        float causticHalo = smoothstep(0.30, 0.55, lineSignal);
        float causticCore = aaStepMask(0.62, lineSignal, 0.06);

        vec3 cyanHalo = isExtension ? vec3(0.7) : vec3(0.0, 0.88, 0.95);
        vec3 pureWhite = vec3(1.0, 1.0, 1.0);
        vec3 causticRgb = cyanHalo * (causticHalo * 0.55) + pureWhite * (causticCore * 1.0);

        // Compressed gain: a strong causticStrength brightens the net without clipping to flat cyan
        float causticGain = u_specColor.a / (1.0 + 0.5 * u_specColor.a);
        finalCaustics = causticRgb * causticsFade * causticGain;
        illuminatedUnderwater = refractedColor * mix(vec3(0.82, 0.92, 0.98), vec3(1.0), 1.0 - causticCore * 0.45) + finalCaustics;
    } else {
        float caustics1 = 1.0 - waterCellNoise(causticsUv1);
        float caustics2 = 1.0 - waterCellNoise(causticsUv2);
        float causticsThreshold = 0.42;
        float causticsStep = aaStepMask(causticsThreshold, caustics1 * caustics2, 0.08);
        finalCaustics = vec3(causticsStep) * causticsFade * vec3(1.0, 0.98, 0.88) * u_specColor.a;
        illuminatedUnderwater = refractedColor + finalCaustics;
    }

    float washNoise = (waterCellNoise(v_worldPos.xz * 0.5 + vec2(u_time * 0.08, u_time * 0.04)) - 0.5) * u_styleA.y;
    // No depth buffer: fresnel is ~0 looking down. Extension styles (styleId 3, e.g. oil) assume a minimum water depth
    // so a dense film does not show the floor through itself.
    float depthProxy = fresnel * 10.0;
    if (isExtension) {
        depthProxy = max(depthProxy, 3.0);
    }
    vec3 transmittance = exp(-depthProxy * waterAbsorption);
    vec3 tintedSeabed = illuminatedUnderwater * shallowColor;
    vec3 inScatterCol = mix(shallowColor, deepColor, 0.35) * 0.15;
    vec3 underwaterLighting = tintedSeabed * transmittance + inScatterCol * (1.0 - transmittance);
    vec3 baseColor = mix(deepColor, underwaterLighting, transmittance);

#ifdef USE_RAMP_LUT
    {
        // Ramp LUT (ADR 0026 route a): artist gradient replaces the hard-coded ramp, constant weight, no rampSoftness gate.
        const float RAMP_LUT_WEIGHT = 0.6;
        float rampT = clamp(fresnel * 3.0 + washNoise, 0.0, 1.0);
        vec3 lutColor = pow(texture2D(u_rampMap, vec2((rampT * 255.0 + 0.5) / 256.0, 0.5)).rgb, vec3(2.2));
        baseColor = mix(baseColor, lutColor, RAMP_LUT_WEIGHT);
    }
#else
    if (u_styleA.x > 0.05) {
        float rampT = clamp(fresnel * 3.0 + washNoise, 0.0, 1.0);
        vec3 midColor = mix(shallowColor, deepColor, 0.5) * vec3(0.9, 1.1, 1.05);
        vec3 softRamp = mix(shallowColor, midColor, smoothstep(0.0, 0.5, rampT));
        softRamp = mix(softRamp, deepColor, smoothstep(0.4, 1.0, rampT));
        baseColor = mix(baseColor, softRamp, u_styleA.x * 0.6);
    }
#endif

    vec3 skyColor = vec3(0.65, 0.85, 1.0);
    float skyFactor = (u_styleB.w > 0.5) ? u_styleB.y : 0.45;
    baseColor = mix(baseColor, skyColor, fresnel * skyFactor);

    vec3 lightDir = normalize(u_dirLightDir);
    vec3 halfVector = normalize(lightDir + viewDir);
    float nDotH = clamp(dot(v_normal, halfVector), 0.0, 1.0);
    // a = specularStrength; narrow cone (wave slopes are smooth over metres)
    float specular = smoothstep(0.9988, 0.9997, nDotH) * u_color.a * 0.5; // halved: the WebGL1 normal is smoother, the lobe grows
    baseColor += u_dirLightColor * specular;

    if (u_styleB.z > 0.0) {
        float stepFps = isSparkle ? 8.0 : 12.0;
        float glint = waterGlintStar(v_worldPos.xz * 2.6, u_time * stepFps, nDotH) * u_styleB.z;
        baseColor += vec3(1.0, 0.92, 0.7) * glint * u_color.a;
    }

    if (u_styleA.z > 0.0) {
        float rippleLine;
        if (painterly) {
            // Painterly strokes: lineWidth = stroke thickness 0..1, phase warped by noise, broken up by a patch mask
            vec2 rp = v_worldPos.xz;
            float rippleWarp = sin(rp.x * 0.7 + u_time * 0.25) * 1.6 + cos(rp.y * 0.9 - u_time * 0.2) * 1.3 + (waterCellNoise(rp * 0.6) - 0.5) * 3.0;
            float rippleAngle = 0.6;
            float ripplePhase = sin(dot(rp, vec2(cos(rippleAngle), sin(rippleAngle))) * 7.0 + rippleWarp * 1.3 + u_time * 0.8);
            float strokeThreshold = cos(clamp(u_styleA.w, 0.02, 1.0) * 1.5708);
            float strokePatch = smoothstep(0.2, 0.55, 1.0 - waterCellNoise(rp * 0.5 + vec2(u_time * 0.05, 0.0)));
            rippleLine = aaStepMask(strokeThreshold, ripplePhase, 0.06) * strokePatch * u_styleA.z * (1.0 - fresnel);
        } else {
            float ripplePattern = sin((v_worldPos.x + v_worldPos.z) * u_styleA.w + u_time * 1.5);
            rippleLine = aaStepMask(0.75, ripplePattern, 0.05) * u_styleA.z * (1.0 - fresnel);
        }
        baseColor += edgeColor * rippleLine * 0.5;
    }

    // No depth buffer: edge colour only at grazing angles (fresnel is ~0 looking straight down, which must not flood the pool)
    float edgeBlend = smoothstep(0.04, 0.04 + 0.5 * edgeSoftness, fresnel);
    float edgeAmount = 0.3; // grazing-angle proxy only: capped so it cannot haze the pool
    if (painterly) {
        edgeAmount = 0.2 * (0.5 + 0.8 * waterCellNoise(v_worldPos.xz * 1.7 + vec2(u_time * 0.05, 0.0)));
    }
    vec3 surfaceColor = mix(baseColor, edgeColor, edgeBlend * edgeAmount);

    // Dredge murk (styleId 4): constant fog, no depth available
    if (isDredge) {
        vec3 fogColor = mix(shallowColor, deepColor, 0.6) * 0.9;
        surfaceColor = mix(surfaceColor, fogColor, 0.55);
    }

    if (isSparkle) {
        // Soft shoulder so saturated cyan keeps a gradient instead of clipping flat
        float sparkleLuma = dot(surfaceColor, vec3(0.299, 0.587, 0.114));
        surfaceColor = mix(vec3(sparkleLuma), surfaceColor, 0.92);
        surfaceColor = surfaceColor * 1.1 / (1.0 + 0.3 * surfaceColor);
    }

    // Toon Foam
    vec3 foamColor = pow(u_matParam1.rgb, vec3(2.2));
    float foamCutoff = u_matParam2.r;
    float foamScale = u_matParam2.g;
    float foamSpeed = u_matParam2.b;
    float foamSoftness = (u_styleB.w > 0.5) ? max(u_styleB.x, 0.01) : 0.06;

    // No depth buffer on WebGL1: grazing angle proxy
    float foamBlend = smoothstep(0.02, 0.02 + 0.3 * foamDistance, fresnel);
    // Top-down proxy: distance to the water mesh border from its UV (0..1 across the quad)
    vec2 edgeUv = min(v_uv, 1.0 - v_uv);
    float edgeDist = min(edgeUv.x, edgeUv.y);
    foamBlend = max(foamBlend, 1.0 - smoothstep(0.0, 0.06 * foamDistance + 0.01, edgeDist));
    vec2 foamUv1 = v_worldPos.xz * foamScale + vec2(u_time * foamSpeed, u_time * foamSpeed * 0.4);
    vec2 foamUv2 = v_worldPos.xz * (foamScale * 1.4) - vec2(u_time * foamSpeed * 0.5, u_time * foamSpeed * 0.8);
    float noise1 = 1.0 - waterCellNoise(foamUv1);
    float noise2 = 1.0 - waterCellNoise(foamUv2);
    float foamMask = (noise1 * noise2) * foamBlend;
    if (painterly) {
        foamMask = pow(foamBlend, 5.0) * mix(0.3, 1.7, clamp(noise1 * noise2 * 3.0, 0.0, 1.0));
    }
    float finalShoreFoam = aaStepMask(foamCutoff, foamMask, foamSoftness);
    if (painterly) {
        finalShoreFoam *= 0.2 * smoothstep(0.25, 0.65, noise1 + 0.35 * noise2);
    }

    vec3 shoreFoamColor = isDredge ? mix(foamColor, surfaceColor, 0.6) : foamColor;
    vec3 finalColor = mix(surfaceColor, shoreFoamColor, finalShoreFoam);

    [WATER_EXT_SURFACE]

    finalColor = pow(finalColor, vec3(1.0 / 2.2));
    gl_FragColor = vec4(finalColor, 1.0);
}
