[BASE_FS_HEADER]

void main() {
    float alpha = texture2D(u_diffuseMap, v_uv).a;
    if (alpha < u_extraParams.y) {
        discard;
    }

    // EVSM moment encoding (ADR 0043), WebGL1 variant -- never reached today (WebGL1 has no
    // shadow mapping), kept so the material can compile on every dialect.
    float depth = clamp(gl_FragCoord.z, 0.0, 1.0);
    float d = clamp(depth * 2.0 - 1.0, -1.0, 1.0);
    float c = 40.0;
    float e = exp(c * d);
    float e2 = e * e;
    float n = -1.0 / e;
    float n2 = n * n;
    gl_FragColor = vec4(e, e2, n, n2);
}
