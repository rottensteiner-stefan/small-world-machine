[BASE_FS_HEADER]

#ifdef USE_UV_TRANSFORMS
uniform vec4 u_uvTransforms[38];
#endif

void main() {
#ifdef USE_UV_TRANSFORMS
    vec4 p0 = u_uvTransforms[0];
    vec4 p1 = u_uvTransforms[1];
#ifdef USE_UV1
    vec2 baseUv = p1.z > 0.5 ? v_uv1 : v_uv0;
#else
    vec2 baseUv = v_uv0;
#endif
    vec2 uvScaled = baseUv * p0.zw;
    vec2 diffuseUv = vec2(p1.x * uvScaled.x - p1.y * uvScaled.y, p1.y * uvScaled.x + p1.x * uvScaled.y) + p0.xy;
#else
    vec2 diffuseUv = v_uv;
#endif
    float alpha = texture2D(u_diffuseMap, diffuseUv).a;
    if (alpha < u_extraParams.y) {
        discard;
    }

    // EVSM moment encoding (ADR 0043), WebGL1 variant -- never reached today (WebGL1 has no
    // shadow mapping), kept so the material can compile on every dialect.
    float depth = clamp(gl_FragCoord.z, 0.0, 1.0);
    float d = clamp(depth * 2.0 - 1.0, -1.0, 1.0);
    float c = 40.0;
    float e = exp(c * d);
    float e2 = e * e;
    float n = -1.0 / e;
    float n2 = n * n;
    gl_FragColor = vec4(e, e2, n, n2);
}
