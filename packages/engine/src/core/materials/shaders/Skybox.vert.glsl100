attribute vec3 a_position;
uniform mat4 u_vp;
uniform mat4 u_model;
uniform vec3 u_viewPos;
varying vec3 v_uvw;
void main() {
    v_uvw = a_position;
    // Center the sky on the camera (the cube follows the viewer, never a fixed scene position).
    // Only the model's linear part (scale/rotation) is applied (w = 0 drops its translation), then
    // the camera position is added: a skybox object placed away from the origin is not shifted
    // relative to the camera. Same as skybox.vert.wgsl.
    vec4 clip = u_vp * (u_model * vec4(a_position, 0.0) + vec4(u_viewPos, 1.0));
    // Pin the sky to the far plane (like `.xyww` in skybox.vert.wgsl) so a camera far plane closer than
    // the cube never clips it. Just below w: depth testing stays LESS against the cleared 1.0.
    gl_Position = vec4(clip.xy, clip.w * 0.99999, clip.w);
}