

[BASE_FS_HEADER]
[FOG_DEFS]
[LIGHT_DEFS]
[PBR_MATH]

uniform float u_metallic;
uniform float u_roughness;
uniform vec4 u_liquidParams;
uniform sampler2D u_opaqueMap;

void main() {
    float ior = u_liquidParams.x;
    float thickness = u_liquidParams.y;
    float transmission = u_liquidParams.z;
    
    vec3 tintColor = u_color.rgb;
    // Assume input color is sRGB, approximate linear conversion (WebGL1 lacks fast sRGB)
    tintColor = pow(tintColor, vec3(2.2));
    
    float metallic = u_metallic;
    float roughness = clamp(u_roughness, 0.05, 1.0);
    
    vec3 V = normalize(u_viewPos - v_worldPos);
    // Mirror the Frostglass GLSL100 fallback guard: honor USE_NORMAL_MAP when the material
    // supplies a normal map (same TBN path as GLSL300), otherwise use the raw vertex normal.
    #ifdef USE_NORMAL_MAP
    vec3 rawNormal = texture2D(u_normalMap, v_uv).rgb * 2.0 - 1.0;
    vec3 N = normalize(v_tbn * rawNormal);
    #else
    vec3 N = normalize(v_normal);
    #endif
    float dotNV = max(dot(N, V), 0.0001);

    vec3 F0 = vec3(0.04);
    F0 = mix(F0, tintColor, metallic);

    vec3 Lo = vec3(0.0);

[GLASS_PBR_LOOPS]

    // --- Screen Space Refraction (Fallback) ---
    vec2 baseScreenUv = v_clipPos.xy / v_clipPos.w * 0.5 + 0.5;
    vec3 refrDir = refract(-V, N, 1.0 / ior);
    vec2 screenUv = baseScreenUv + refrDir.xy * thickness * 0.05;
    screenUv = clamp(screenUv, vec2(0.001), vec2(0.999));
    
    // WebGL1 expects texture2D, approximate linear conversion
    vec3 refractedColor = texture2D(u_opaqueMap, screenUv).rgb;
    refractedColor = pow(refractedColor, vec3(2.2));
    
    vec3 transmittance = exp(-((vec3(1.0) - tintColor) * thickness * 3.0));
    vec3 finalRefraction = refractedColor * transmittance * transmission;
    
    // Ambient Light
    vec3 ambient = u_ambientColor * tintColor * u_extraParams.x; // u_extraParams.x is AO

    vec3 F_refr = F_Schlick(dotNV, F0);
    vec3 kD_refr = (vec3(1.0) - F_refr) * (1.0 - metallic);
    
    vec3 color = ambient + Lo + finalRefraction * kD_refr;
    
    // Tone Mapping (Simple Reinhard)
    // u_exposure is missing in WebGL1 shader layout, so we skip exposure mult
    color = color / (color + vec3(1.0));
    
    // Gamma Correction
    color = pow(color, vec3(1.0 / 2.2));
    
    [FOG_CALC]
    
    gl_FragColor = vec4(color, 1.0);
}
