{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://small-world-machine.dev/schemas/kit.schema.json",
  "title": "Small World Machine Asset Kit Manifest",
  "description": "Schema for a kit's kit.json catalog — see docs/adr/0011-modular-asset-kits-and-remote-catalog.md. Validated by packages/engine/tests/loaders/AssetKitValidation.test.ts, which also cross-checks the file-existence and cross-reference constraints this schema cannot express.",
  "type": "object",
  "required": ["id", "name", "version", "description", "author", "license"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "description": "Kit id — must equal the kit's own directory name under public/assets/kits/.",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "description": "3D props with their own model.glb + preview + meta.json.",
      "items": { "$ref": "#/$defs/item" }
    },
    "textures": {
      "type": "array",
      "description": "PBR material sets (no triangles/dimensions, so no separate meta.json).",
      "items": { "$ref": "#/$defs/texture" }
    },
    "decals": {
      "type": "array",
      "description": "Single decals/stencils (PNG or WebP, no separate meta.json).",
      "items": { "$ref": "#/$defs/decal" }
    },
    "author": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "namespacedId": {
      "type": "string",
      "description": "Always '<kit-id>/<slug>' — enforced against the manifest's own id at test time, since a JSON Schema can't see its own document's other fields.",
      "pattern": "^[a-z][a-z0-9_-]*/[a-z][a-z0-9_]*$"
    },
    "item": {
      "type": "object",
      "required": ["id", "name", "category", "path", "preview", "meta"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "hazardClass": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "description": "Relative to the kit root (not to the item's own folder).",
          "pattern": "\\.glb$"
        },
        "preview": { "type": "string", "pattern": "\\.(jpg|jpeg|png|webp)$" },
        "meta": { "type": "string", "pattern": "\\.json$" }
      }
    },
    "texture": {
      "type": "object",
      "required": ["id", "name", "category", "maps"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "maps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "\\.(png|webp)$" }
        }
      }
    },
    "decal": {
      "type": "object",
      "required": ["id", "name", "file"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "name": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "pattern": "\\.(png|webp)$" },
        "normal": { "type": "string", "pattern": "\\.(png|webp)$" },
        "orm": { "type": "string", "pattern": "\\.(png|webp)$" },
        "emission": { "type": "string", "pattern": "\\.(png|webp)$" },
        "size": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "unlit": { "type": "boolean" }
      }
    }
  }
}
