{
  "name": "small-world-machine",
  "private": true,
  "version": "0.106.0",
  "description": "A lightweight 3D engine for hybrid WebGL/WebGPU rendering pipelines.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Stefan Rottensteiner",
    "email": "rottensteiner.stefan@gmx.de"
  },
  "contributors": [
    "Google Gemini",
    "Anthropic Code Claude",
    "DeepSeek"
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm-run-all build:showcases build:lib",
    "build:showcases": "vite build && cp -a dist/public/. dist/ && rm -rf dist/public",
    "build:lib": "npm run build --workspace=packages/engine",
    "css:audit": "node scripts/audit-css-tokens.js",
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' vite --host",
    "format": "prettier --write . && eslint . --fix",
    "lint": "eslint .",
    "lint:wgsl": "tsx scripts/lint-wgsl.ts",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/update-version.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:showcases": "node scripts/check-showcases.js",
    "test:decals": "node scripts/check-decals.mjs",
    "probe:gpu-parity": "node scripts/probe-gpu-parity.js",
    "perf:liquid": "node scripts/perf-liquid.mjs",
    "webgpu:resize-stress": "node scripts/webgpu-resize-stress.js",
    "goldens:capture": "node scripts/goldens/capture.js",
    "goldens:compare": "node scripts/goldens/compare.js",
    "goldens:grade": "node scripts/goldens/differential-grader.js",
    "worktree:new": "node scripts/worktree-new.mjs",
    "aniso:compare": "node scripts/aniso-compare.mjs",
    "start": "npm run build && npx serve dist",
    "prepare": "husky",
    "docs:dev": "vitepress dev docs --port 5174",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:api": "typedoc",
    "docs:build-all": "npm run docs:api && npm run docs:build",
    "ibl:bake": "tsx scripts/ibl-bake.ts",
    "test:ibl": "tsx scripts/ibl-bake.ts --seed 11 --out .agents/scratches/ibl-bake"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@webgpu/types": "^0.1.71",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "npm-run-all": "^4.1.5",
    "pixelmatch": "^7.2.0",
    "prettier": "^3.9.6",
    "puppeteer": "^25.4.0",
    "serve": "^14.2.6",
    "simplex-noise": "^4.0.3",
    "terser": "^5.49.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.5",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-mkcert": "^2.1.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "wgsl_reflect": "^1.5.0"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.wgsl": [
      "npm run lint:wgsl"
    ]
  },
  "allowScripts": {
    "puppeteer@25.4.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
